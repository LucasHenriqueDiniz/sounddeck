{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chimer",
  "compatibility_date": "2026-08-19",
  // Both domains stay attached on purpose. chimer is the new canonical host;
  // sounddeck keeps answering because every download link already published —
  // in release notes, in the winget manifest's PackageUrl — points at it.
  // Dropping it would break those, so it is kept and every page served from it
  // carries a canonical pointing at chimer, which is the correct migration
  // signal rather than a hard cut.
  "routes": [
    { "pattern": "chimer.lucashdo.com", "custom_domain": true },
    { "pattern": "sounddeck.lucashdo.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "dist",
    "html_handling": "auto-trailing-slash",
    // Every page is prerendered, so an unknown path is genuinely missing.
    // "single-page-application" would answer 200 with the home page and
    // hand crawlers unlimited duplicate URLs.
    "not_found_handling": "404-page"
  }
}
