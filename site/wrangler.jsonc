{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chimer",
  "compatibility_date": "2026-08-19",
  // The domain is still sounddeck.lucashdo.com — the rename hasn't happened
  // there yet. Point this at the new host once it does, and keep a redirect
  // from the old one so published download links don't break.
  "routes": [{ "pattern": "sounddeck.lucashdo.com", "custom_domain": true }],
  "assets": {
    "directory": "dist",
    "html_handling": "auto-trailing-slash",
    // Every page is prerendered, so an unknown path is genuinely missing.
    // "single-page-application" would answer 200 with the home page and
    // hand crawlers unlimited duplicate URLs.
    "not_found_handling": "404-page"
  }
}
