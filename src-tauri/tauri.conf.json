{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundDeck",
  "version": "0.1.0",
  "identifier": "com.sounddeck.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SoundDeck",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 640,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Lucas Henrique Diniz Ostroski",
    "copyright": "Copyright (c) 2026 Lucas Henrique Diniz Ostroski",
    "license": "MIT",
    "homepage": "https://sounddeck.lucashdo.com",
    "shortDescription": "A sound scheme picker for Windows 10 and 11.",
    "longDescription": "Browse sound packs, preview every system event, and apply a whole scheme in one click. The previous scheme is backed up before any change, so every apply is reversible.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "5D9E4064-1D5C-54EF-99FE-5BE007530355"
      }
    }
  }
}
