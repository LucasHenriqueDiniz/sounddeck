{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sounddeck",
  "compatibility_date": "2026-08-18",
  "routes": [
    { "pattern": "sounddeck.lucashdo.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
